{
  "name": "shaagent",
  "version": "0.1.0",
  "description": "Scaffold production-grade multi-agent AI systems into any repository",
  "bin": {
    "shaagent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc && node scripts/bundle.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "chalk": "^5.3.0",
    "handlebars": "^4.7.8",
    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "detect-indent": "^7.0.1",
    "read-pkg-up": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/inquirer": "^9.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/handlebars": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.21.0"
  },
  "keywords": ["ai", "agent", "multi-agent", "opencode", "claude", "copilot", "scaffold"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
