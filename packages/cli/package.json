{
  "name": "shaagent",
  "version": "0.2.7",
  "description": "Scaffold production-grade multi-agent AI systems into any repository",
  "bin": {
    "shaagent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "detect-indent": "^7.0.1",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "read-pkg-up": "^11.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vite-node": "6.0.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "opencode",
    "claude",
    "copilot",
    "scaffold"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
